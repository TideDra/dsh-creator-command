{
  "name": "@local/dsh-creator-command",
  "version": "1.0.0",
  "description": "Adds the /creator slash command to dynamically equip any agent session with DSH Creator mode skills and tools.",
  "private": true,
  "license": "MIT",
  "author": "TideDra",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TideDra/dsh-creator-command.git"
  },
  "homepage": "https://github.com/TideDra/dsh-creator-command#readme",
  "bugs": {
    "url": "https://github.com/TideDra/dsh-creator-command/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "slash-command",
    "creator-mode"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
